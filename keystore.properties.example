# Copia este archivo como keystore.properties (no se versiona) y completa los valores.
# Generar el keystore:
#   keytool -genkeypair -v -keystore captura-release.jks -alias captura -keyalg RSA -keysize 2048 -validity 10000
storeFile=captura-release.jks
storePassword=CAMBIAR
keyAlias=captura
keyPassword=CAMBIAR
